<!DOCTYPE html>
<html>
<body style="font-family:system-ui;padding:24px;text-align:center">
  <style>
    #clicker { padding: 12px 24px; font-size: 18px; cursor: pointer; }
    .done { background: #16a34a !important; color: white; }
  </style>
  
  <p id="count" style="font-size:32px;font-weight:bold;margin:16px 0">0</p>
  <p id="message" style="font-size:16px;color:#666">Keep clicking...</p>
  
  <button id="clicker">Click me</button>  

  <script>
    const btn = document.querySelector('#clicker');
    const countEl = document.querySelector('#count');
    const msg = document.querySelector('#message');
    let count = 0;

    btn.addEventListener('click', () => {
      count++;
      countEl.textContent = count;
      if (count >= 5) {
        btn.classList.add('done');
        msg.textContent = '🎉 Congratulations! You clicked 5 times!';
      }
   });
  </script>
</body>
</html>